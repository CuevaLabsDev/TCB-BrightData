# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local IDE / agent skills (not part of shipped app)
.agents/
.cursor/
.claude/

# submission build artifacts (sources committed; regenerate with npm run submission:*)
submission/presentation/output/
submission/video/output/
submission/video/raw/

# python pipeline
pipeline/.venv
__pycache__/
*.pyc
.pytest_cache/
